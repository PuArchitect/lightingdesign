{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightingDesign SSOT Results Schema (v2.1)",
  "type": "object",
  "required": ["schema_version", "project_name", "room_name", "capability_level", "credibility_grades",
               "workplane_usable", "workplane_active", "power_summary", "fixtures", "scenes", "targets"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["2.0", "2.1"] },
    "project_name": { "type": "string" },
    "room_name": { "type": "string" },
    "drawing_no": { "type": "string" },
    "company": { "type": "string" },
    "capability_level": { "type": "string", "enum": ["L1", "L2", "L3"] },
    "coordinate_frame": { "type": "string", "enum": ["model", "local"], "description": "fixture_positions_mm 的坐标基准；缺省时按模型坐标推断" },
    "credibility_grades": {
      "type": "object",
      "required": ["geometry", "photometry", "material"],
      "properties": {
        "geometry": { "type": "string", "enum": ["A", "B", "B-", "C", "D"] },
        "photometry": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "material": { "type": "string", "enum": ["A", "B", "C", "D"] }
      }
    },
    "targets": {
      "type": "object",
      "description": "v2.1：必须同时包含验收口径 T-A 与运行口径 T-B",
      "properties": {
        "acceptance": {
          "type": "object",
          "properties": {
            "workplane_0_75m_lx": { "type": "number" },
            "initial_design_lx": { "type": "number" },
            "maintenance_factor": { "type": "number" }
          }
        },
        "operation": {
          "type": "object",
          "properties": {
            "ambient_lx": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "table_lx": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "accent_lx": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
          }
        }
      }
    },
    "area_basis": { "type": "string", "description": "LPD 分母口径（如 whole_room_20.35）" },
    "grid_mask": {
      "type": "object",
      "description": "统计口径：网格尺寸、高度、家具/服务核剔除规则",
      "properties": {
        "step_m": { "type": "number" }, "z_m": { "type": "number" },
        "exclude_furniture": { "type": "boolean" }, "exclude_service_core": { "type": "boolean" }
      }
    },
    "workplane_usable": {
      "type": "object",
      "required": ["height_m", "avg_lx", "min_lx", "max_lx", "uo", "valid_points"],
      "properties": {
        "height_m": { "type": "number" }, "avg_lx": { "type": "number", "minimum": 0 },
        "min_lx": { "type": "number", "minimum": 0 }, "max_lx": { "type": "number", "minimum": 0 },
        "uo": { "type": "number", "minimum": 0, "maximum": 1 }, "valid_points": { "type": "integer", "minimum": 1 }
      }
    },
    "workplane_active": {
      "type": "object",
      "required": ["height_m", "wall_margin_m", "avg_lx", "uo", "valid_points"],
      "properties": {
        "height_m": { "type": "number" }, "wall_margin_m": { "type": "number", "minimum": 0 },
        "avg_lx": { "type": "number", "minimum": 0 }, "uo": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid_points": { "type": "integer", "minimum": 1 }
      }
    },
    "single_source_contributions_lx": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 },
      "description": "各独立光源对工作面可用区的实算照度贡献（L3 必填，供 03_audit_closure.py 校验）"
    },
    "power_summary": {
      "type": "object",
      "required": ["total_lumens", "led_system_efficacy_lm_w", "efficacy_assumption_grade", "total_power_w", "room_area_m2", "lpd_w_m2"],
      "properties": {
        "total_lumens": { "type": "number", "minimum": 0 },
        "led_system_efficacy_lm_w": { "type": "number", "exclusiveMinimum": 0 },
        "efficacy_assumption_grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "total_power_w": { "type": "number", "minimum": 0 },
        "room_area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "lpd_w_m2": { "type": "number", "minimum": 0 }
      }
    },
    "fixtures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "layer", "cct_k", "total_lumens"],
        "properties": {
          "code": { "type": "string" }, "name": { "type": "string" }, "layer": { "type": "string" },
          "cct_k": { "type": "integer" }, "quantity_or_length": { "type": "string" },
          "total_lumens": { "type": "number", "minimum": 0 }, "circuit": { "type": "string" }
        }
      }
    },
    "fixture_positions_mm": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "x_mm", "y_mm"],
        "properties": {
          "code": { "type": "string" }, "x_mm": { "type": "number" }, "y_mm": { "type": "number" }, "z_mm": { "type": "number" }
        }
      }
    },
    "scenes": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "dimming_ratios", "estimated_avg_lx"],
        "properties": {
          "name": { "type": "string" }, "description": { "type": "string" },
          "dimming_ratios": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 } },
          "estimated_avg_lx": { "type": "number", "minimum": 0 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "数据溯源：几何/材质/计算脚本与结果文件的相对路径",
      "additionalProperties": { "type": "string" }
    }
  }
}
